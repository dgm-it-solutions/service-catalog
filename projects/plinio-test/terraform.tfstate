            "id": "2177256194",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"apigateway\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"apigateway:*\",\n      \"Resource\": [\n        \"arn:aws:apigateway:us-east-1::/*/*\",\n        \"arn:aws:apigateway:us-east-1::/*\"\n      ]\n    },\n    {\n      \"Sid\": \"lambda\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"lambda:*\",\n      \"Resource\": [\n        \"arn:aws:lambda:us-east-1:147997117328:layer:*\",\n        \"arn:aws:lambda:us-east-1:147997117328:function:*\",\n        \"arn:aws:lambda:us-east-1:147997117328:event-source-mapping:*\",\n        \"arn:aws:lambda:us-east-1:147997117328:code-signing-config:*\"\n      ]\n    },\n    {\n      \"Sid\": \"cloudformationReadOnly\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"cloudformation:List*\",\n        \"cloudformation:Get*\",\n        \"cloudformation:Describe*\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"cloudformationWrite\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"cloudformation:Update*\",\n        \"cloudformation:ExecuteChangeSet\",\n        \"cloudformation:Create*\"\n      ],\n      \"Resource\": [\n        \"arn:aws:cloudformation:us-east-1:aws:transform/Serverless-2016-10-31\",\n        \"arn:aws:cloudformation:us-east-1:147997117328:stack/plinio-test*\",\n        \"arn:aws:cloudformation:us-east-1:147997117328:changeSet/*/*\"\n      ]\n    },\n    {\n      \"Sid\": \"s3ReadOnly\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:ListMultipartUploadParts\",\n        \"s3:ListBucket\",\n        \"s3:GetObject\"\n      ],\n      \"Resource\": [\n        \"arn:aws:s3:::aws-sam-cli-managed-default-samclisourcebucket-*/*\",\n        \"arn:aws:s3:::aws-sam-cli-managed-default-samclisourcebucket-*\"\n      ]\n    },\n    {\n      \"Sid\": \"s3Write\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObjectTagging\",\n        \"s3:PutObject\"\n      ],\n      \"Resource\": \"arn:aws:s3:::aws-sam-cli-managed-default-samclisourcebucket-*/*\"\n    },\n    {\n      \"Sid\": \"iam\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:*\",\n      \"Resource\": \"arn:aws:iam::147997117328:role/plinio-test*\"\n    },\n    {\n      \"Sid\": \"iamPassRole\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:PassRole\",\n      \"Resource\": \"*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"iam:PassedToService\": [\n            \"lambda.amazonaws.com\",\n            \"apigateway.amazonaws.com\"\n          ]\n        }\n      }\n    },\n    {\n      \"Sid\": \"dynamodb\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"dynamodb:*\",\n      \"Resource\": [\n        \"arn:aws:dynamodb:us-east-1:147997117328:table/plinio-test*/stream/*\",\n        \"arn:aws:dynamodb:us-east-1:147997117328:table/plinio-test*/index/*\",\n        \"arn:aws:dynamodb:us-east-1:147997117328:table/plinio-test*/backup/*\",\n        \"arn:aws:dynamodb:us-east-1:147997117328:table/plinio-test*\"\n      ]\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"apigateway\",\"Effect\":\"Allow\",\"Action\":\"apigateway:*\",\"Resource\":[\"arn:aws:apigateway:us-east-1::/*/*\",\"arn:aws:apigateway:us-east-1::/*\"]},{\"Sid\":\"lambda\",\"Effect\":\"Allow\",\"Action\":\"lambda:*\",\"Resource\":[\"arn:aws:lambda:us-east-1:147997117328:layer:*\",\"arn:aws:lambda:us-east-1:147997117328:function:*\",\"arn:aws:lambda:us-east-1:147997117328:event-source-mapping:*\",\"arn:aws:lambda:us-east-1:147997117328:code-signing-config:*\"]},{\"Sid\":\"cloudformationReadOnly\",\"Effect\":\"Allow\",\"Action\":[\"cloudformation:List*\",\"cloudformation:Get*\",\"cloudformation:Describe*\"],\"Resource\":\"*\"},{\"Sid\":\"cloudformationWrite\",\"Effect\":\"Allow\",\"Action\":[\"cloudformation:Update*\",\"cloudformation:ExecuteChangeSet\",\"cloudformation:Create*\"],\"Resource\":[\"arn:aws:cloudformation:us-east-1:aws:transform/Serverless-2016-10-31\",\"arn:aws:cloudformation:us-east-1:147997117328:stack/plinio-test*\",\"arn:aws:cloudformation:us-east-1:147997117328:changeSet/*/*\"]},{\"Sid\":\"s3ReadOnly\",\"Effect\":\"Allow\",\"Action\":[\"s3:ListMultipartUploadParts\",\"s3:ListBucket\",\"s3:GetObject\"],\"Resource\":[\"arn:aws:s3:::aws-sam-cli-managed-default-samclisourcebucket-*/*\",\"arn:aws:s3:::aws-sam-cli-managed-default-samclisourcebucket-*\"]},{\"Sid\":\"s3Write\",\"Effect\":\"Allow\",\"Action\":[\"s3:PutObjectTagging\",\"s3:PutObject\"],\"Resource\":\"arn:aws:s3:::aws-sam-cli-managed-default-samclisourcebucket-*/*\"},{\"Sid\":\"iam\",\"Effect\":\"Allow\",\"Action\":\"iam:*\",\"Resource\":\"arn:aws:iam::147997117328:role/plinio-test*\"},{\"Sid\":\"iamPassRole\",\"Effect\":\"Allow\",\"Action\":\"iam:PassRole\",\"Resource\":\"*\",\"Condition\":{\"StringEquals\":{\"iam:PassedToService\":[\"lambda.amazonaws.com\",\"apigateway.amazonaws.com\"]}}},{\"Sid\":\"dynamodb\",\"Effect\":\"Allow\",\"Action\":\"dynamodb:*\",\"Resource\":[\"arn:aws:dynamodb:us-east-1:1479971